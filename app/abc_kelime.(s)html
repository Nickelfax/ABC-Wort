            if(!entered)html+=`<div class="char-block" style="min-width:28px;border-color:#ccc;background:#f8f9fa;">_</div>`;
            else{const ok=entered.toLowerCase()===ziel[i].toLowerCase();html+=`<div class="char-block" style="border-color:${ok?'var(--success)':'var(--danger)'};background:${ok?'#eafaf1':'#fdecea'}">${entered}</div>`;}
        }else{
