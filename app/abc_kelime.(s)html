function diktatAddChar(ch){
    const now=Date.now();if(now-_lastDiktatAddTime<80)return;_lastDiktatAddTime=now;
    if(diktatGesperrt)return;
    const ziel=diktatAktuell.toLowerCase();const idx=diktatEingabe.length;if(idx>=ziel.length)return;
    diktatEingabe+=ch;
    if(!diktatStumm)sprichZeichenTTS(ch);
    if(ch.toLowerCase()!==ziel[idx]){diktatHatFehler=true;if(!diktatBuzzerGespielt){diktatBuzzerGespielt=true;diktatBuzzer();setTimeout(()=>{diktatBuzzerGespielt=false;},600);}}
    diktatRender();
    if(diktatEingabe.toLowerCase()===ziel){
        diktatGesperrt=true;
        if(!diktatHatFehler){diktatRichtig++;document.getElementById('diktatRichtig').textContent=diktatRichtig;document.getElementById('diktatStatus').textContent='Doğru! 🎉';}
        else{diktatFalsch++;document.getElementById('diktatFalsch').textContent=diktatFalsch;document.getElementById('diktatStatus').textContent='Doğru — ama düzeltmelerle.';}
        setTimeout(diktatFanfare,300);setTimeout(diktatNeuesWort,2400);
    }else{document.getElementById('diktatStatus').textContent=diktatEingabe.length<ziel.length?'Devam et…':'Henüz değil…';}
}
let _diktatCtx=null;
function getDiktatCtx(){if(!_diktatCtx)_diktatCtx=new(window.AudioContext||window.webkitAudioContext)();return _diktatCtx;}
function diktatFanfare(){try{const ctx=getDiktatCtx();const t=ctx.currentTime+0.05;[[523,0],[659,0.13],[784,0.26],[1047,0.39]].forEach(([f,d])=>{const o=ctx.createOscillator(),g=ctx.createGain();o.frequency.value=f;g.gain.setValueAtTime(0,t+d);g.gain.linearRampToValueAtTime(0.2,t+d+0.02);g.gain.exponentialRampToValueAtTime(0.001,t+d+0.3);o.connect(g);g.connect(ctx.destination);o.start(t+d);o.stop(t+d+0.3);});}catch(e){}}
function diktatBuzzer(){try{const ctx=getDiktatCtx();const o=ctx.createOscillator(),g=ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(180,ctx.currentTime);o.frequency.exponentialRampToValueAtTime(90,ctx.currentTime+0.18);g.gain.setValueAtTime(0.25,ctx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.22);o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+0.22);}catch(e){}}

