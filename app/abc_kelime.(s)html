function proIstAktiv(appId) {
    if (!appId) return false;
    const app = APP_REGISTRY.find(a => a.id === appId);
    if (!app || !app.proCode) return true;
    try { return localStorage.getItem('abc_pro_' + appId) === 'true'; } catch(e) { return false; }
}
function proAktivierenFuerApp(appId, code) {
    const app = APP_REGISTRY.find(a => a.id === appId);
    if (!app) return false;
    if (code.toUpperCase() === app.proCode) {
        try { localStorage.setItem('abc_pro_' + appId, 'true'); } catch(e) {}
        return true;
    }
    return false;
}
const FREIE_RUNDEN = 10;
function proCheck(appId, feature, onSuccess) {
    if (proIstAktiv(appId)) { onSuccess && onSuccess(); return true; }
    let runden = 0;
    try { runden = parseInt(localStorage.getItem('abc_runden_' + appId) || '0'); } catch(e) {}
    if (runden < FREIE_RUNDEN) {
        try { localStorage.setItem('abc_runden_' + appId, runden + 1); } catch(e) {}
        onSuccess && onSuccess();
        return true;
    }
    proGateAnzeigen(appId, feature);
    return false;
}
function proGateAnzeigen(appId, feature) {
    const app = APP_REGISTRY.find(a => a.id === appId);
    const display = document.getElementById('wordDisplay');
    if (!display) return;
    display.classList.remove('empty');
    display.innerHTML = `
        <div style="text-align:center; padding:1rem; width:100%;">
            <div style="font-size:2.5rem; margin-bottom:8px;">${app.flag}</div>
            <div style="font-size:1rem; font-weight:bold; color:#2c3e50; margin-bottom:6px;">Pro Sürüm</div>
            <div style="font-size:0.85rem; color:#7f8c8d; margin-bottom:4px;">${feature} · sınırsız</div>
            <div style="font-size:1.1rem; font-weight:bold; color:${app.color}; margin-bottom:16px;">2,99 € – tek seferlik</div>
            <button onclick="proKaufen('${appId}')"
                style="background:${app.color}; padding:10px 20px; border-radius:10px; color:white; border:none; cursor:pointer; font-weight:bold; font-size:1rem; margin-bottom:8px; display:block; width:100%;">
                Pro'yu aç ☕ – 2,99€
            </button>
            <button onclick="proCodeEingeben('${appId}')"
                style="background:var(--success,#27ae60); padding:8px 20px; border-radius:10px; color:white; border:none; cursor:pointer; font-size:0.85rem; width:100%;">
                Zaten ödedim ✓
            </button>
        </div>`;
}
function proKaufen(appId) {
    window.open('https://ko-fi.com/nickelfax', '_blank');
    showToast('Ödeme sonrası kodunu Ko-fi mesajıyla alacaksın!');
}
function proCodeEingeben(appId) {
    const code = prompt('Pro kodunu gir:');
    if (!code) return;
    if (proAktivierenFuerApp(appId, code)) {
        showToast('Pro aktif! İyi eğlenceler! 🎉');
        try { localStorage.removeItem('abc_runden_' + appId); } catch(e) {}
        updateDisplay();
        if (typeof diktatNeuesWort === 'function' && diktatAktiv) diktatNeuesWort();
        if (typeof grammatikNeueAufgabe === 'function' && grammatikAktiv) grammatikNeueAufgabe();
    } else {
        showToast('Yanlış kod – ödeme sonrası Ko-fi\'den sor!');
    }
}
function crossSellBannerEinfuegen(currentAppId) {
    const andere = APP_REGISTRY.filter(a => a.id !== currentAppId);
