function tempusAntwort(g,btn){if(grammatikGesperrt)return;grammatikGesperrt=true;if(g===grammatikAktuell.richtig){btn.classList.add('richtig');diktatRichtig++;document.getElementById('diktatRichtig').textContent=diktatRichtig;document.getElementById('diktatStatus').textContent='Doğru! 🎉';setTimeout(diktatFanfare,200);}else{btn.classList.add('falsch');diktatFalsch++;document.getElementById('diktatFalsch').textContent=diktatFalsch;document.getElementById('diktatStatus').textContent=`Doğrusu: ${grammatikAktuell.richtig}`;}setTimeout(grammatikNeueAufgabe,1800);}
function grammatikSprechen(){let text='';if(grammatikModus==='plural'&&grammatikAktuell)text=grammatikAktuell.wort;else if(grammatikModus==='konjugation'&&grammatikAktuell)text=pronounsTTS[grammatikAktuell.pIdx]+' '+grammatikAktuell.verb;if(!text)return;ttsSpeak(text, 0.85, 'tr-TR');}
function uebersetzungToggle(){uebersetzungAktiv=document.getElementById('uebersetzungToggleSwitch').checked;if(!uebersetzungAktiv)document.getElementById('uebersetzungAnzeige').textContent='';}
function zeigUebersetzung(wort){if(!uebersetzungAktiv)return;const eintrag=Object.values(GLOBAL_DICT).find(e=>e.tr&&e.tr.toLowerCase()===wort.toLowerCase());const ue=eintrag?eintrag.de:undefined;document.getElementById('uebersetzungAnzeige').textContent=ue?'🇩🇪 '+ue:'';}
function openStorage(){const c=document.getElementById('storedWordsList');c.innerHTML='';if(!savedWords.length){c.innerHTML='<p style="color:#7f8c8d;text-align:center;">Henüz kaydedilen kelime yok.</p>';}else savedWords.forEach((w,i)=>{const div=document.createElement('div');div.className='stored-word';div.innerHTML=`<span>${w}</span>`;const b=document.createElement('button');b.className='btn-delete';b.style.background='var(--danger)';b.style.color='white';b.style.padding='5px 10px';b.style.fontSize='0.8rem';b.style.borderRadius='8px';b.style.border='none';b.textContent='Sil';b.onclick=()=>{savedWords.splice(i,1);try{localStorage.setItem('abckelime_saved',JSON.stringify(savedWords));}catch(e){}openStorage();};div.appendChild(b);c.appendChild(div);});document.getElementById('storageModal').classList.add('open');}
function closeStorage(){document.getElementById('storageModal').classList.remove('open');}
let toastTimer=null;
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');if(toastTimer)clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),1800);}

