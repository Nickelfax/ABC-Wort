function getVoiceForLang(lang) {
    const voices = window.speechSynthesis.getVoices();
    return voices.find(v => v.lang && v.lang.startsWith(lang.split('-')[0])) || voices[0] || null;
}
function ttsSpeak(text, rate, lang) {
    if (!window.speechSynthesis) { showToast('⚠️ Bu cihazda TTS mevcut değil'); return; }
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    const voice = getVoiceForLang(lang);
    if (voice) { u.voice = voice; u.lang = voice.lang; }
    else { u.lang = lang; }
    u.rate = rate;
    window.speechSynthesis.speak(u);
}
function sprichZeichenTTS(ch) { ttsSpeak(ch.toLowerCase(), 0.7, 'tr-TR'); }
function sprichWort() {
    const s=currentWord.join(''); if(!s)return;
