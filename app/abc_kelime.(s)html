function grammatikNeueAufgabe(){
    if(!proCheck(THIS_APP_ID,'Sınırsız dilbilgisi'))return;
    const display=document.getElementById('wordDisplay');display.classList.remove('empty');grammatikGesperrt=false;
    if(grammatikModus==='plural'){
        const pool=grammatikDaten.plural[diktatNiveau]||grammatikDaten.plural.n1;
        const e=pool[Math.floor(Math.random()*pool.length)];grammatikAktuell=e;
        display.innerHTML=`<div style="width:100%;display:flex;flex-direction:column;align-items:center;gap:12px;">
            <div style="font-size:2rem;">${e.emoji}</div>
            <div class="grammatik-aufgabe">${e.wort}</div>
            <div class="grammatik-hinweis">Çoğulu nedir?</div>
            <div class="artikel-buttons">
                <button class="art-btn" onclick="pluralAntwort('${e.wort}ler',this)">${e.wort}ler</button>
                <button class="art-btn" onclick="pluralAntwort('${e.wort}lar',this)">${e.wort}lar</button>
            </div></div>`;
        grammatikSprechen();
    }else if(grammatikModus==='kasus'){
        const pool=grammatikDaten.kasus[diktatNiveau]||grammatikDaten.kasus.n1;
        const e=pool[Math.floor(Math.random()*pool.length)];grammatikAktuell=e;
        const gemischt=[...e.antworten].sort(()=>Math.random()-0.5);
        display.innerHTML=`<div style="width:100%;display:flex;flex-direction:column;align-items:center;gap:12px;">
            <div class="grammatik-aufgabe">${e.satz}</div>
            <div class="grammatik-hinweis">„${e.wort}" için doğru hali seç</div>
            <div class="auswahl-grid">${gemischt.map(a=>`<button class="auswahl-btn" onclick="kasusAntwort('${a}',this)">${a}</button>`).join('')}</div></div>`;
        grammatikSprechen();
    }else if(grammatikModus==='konjugation'){
        const pool=verbGroups[diktatNiveau]||verbGroups.n1;
        const verb=pool[Math.floor(Math.random()*pool.length)];
        const formen=verbForms[verb];if(!formen){grammatikNeueAufgabe();return;}
        const pIdx=Math.floor(Math.random()*6);const richtig=formen[pIdx];
        const falschForms=formen.filter((_,i)=>i!==pIdx).sort(()=>Math.random()-0.5).slice(0,3);
        const alle=[richtig,...falschForms].sort(()=>Math.random()-0.5);
        grammatikAktuell={verb,pIdx,richtig};
        display.innerHTML=`<div style="width:100%;display:flex;flex-direction:column;align-items:center;gap:12px;">
            <div class="grammatik-aufgabe">${pronouns[pIdx]} ___ <span style="color:var(--primary)">${verb}</span></div>
            <div class="grammatik-hinweis">Geniş zaman</div>
            <div class="auswahl-grid">${alle.map(a=>`<button class="auswahl-btn" onclick="konjAntwort('${a}',this)">${a}</button>`).join('')}</div></div>`;
        grammatikSprechen();
    }else if(grammatikModus==='tempus'){
        const pool=[...(grammatikDaten.tempus.n1||[]),...(grammatikDaten.tempus.n2||[]),...(grammatikDaten.tempus.n3||[])];
        const e=pool[Math.floor(Math.random()*pool.length)];grammatikAktuell=e;
        const alle=[e.richtig,...e.falsch].sort(()=>Math.random()-0.5);
        display.innerHTML=`<div style="width:100%;display:flex;flex-direction:column;align-items:center;gap:12px;">
            <div class="grammatik-aufgabe">${e.pronomen} ___ <span style="color:var(--primary)">${e.infinitiv}</span></div>
            <div class="grammatik-hinweis">${e.zeit}</div>
            <div class="auswahl-grid">${alle.map(a=>`<button class="auswahl-btn" onclick="tempusAntwort('${a.replace(/'/g,"\\'")}',this)">${a}</button>`).join('')}</div></div>`;
    }
    document.getElementById('diktatStatus').textContent='';
}
function pluralAntwort(g,btn){if(grammatikGesperrt)return;grammatikGesperrt=true;if(g===grammatikAktuell.plural){btn.classList.add('richtig');diktatRichtig++;document.getElementById('diktatRichtig').textContent=diktatRichtig;document.getElementById('diktatStatus').textContent='Doğru! 🎉';setTimeout(diktatFanfare,200);}else{btn.classList.add('falsch');diktatFalsch++;document.getElementById('diktatFalsch').textContent=diktatFalsch;document.getElementById('diktatStatus').textContent=`Doğrusu: "${grammatikAktuell.plural}"`;}setTimeout(grammatikNeueAufgabe,1800);}
