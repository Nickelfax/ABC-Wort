}
function uebersetzungToggle() {
    uebersetzungAktiv = document.getElementById('uebersetzungToggleSwitch').checked;
    const dropdown = document.getElementById('sprachDropdownInControls');
    const anzeige  = document.getElementById('uebersetzungAnzeige');
    if (uebersetzungAktiv) {
        if (dropdown) dropdown.style.display = 'block';
