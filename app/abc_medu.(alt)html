// ── Dark Mode ─────────────────────────────────────────────────────────
function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    document.getElementById('themeBtn').textContent = isDark ? '☀️' : '🌙';
    try { localStorage.setItem('abcmedu_theme', isDark ? 'dark' : 'light'); } catch(e) {}
}
function initTheme() {
    try {
        if (localStorage.getItem('abcmedu_theme') === 'dark') {
            document.documentElement.classList.add('dark');
            const btn = document.getElementById('themeBtn');
            if (btn) btn.textContent = '☀️';
        }
    } catch(e) {}
}
function init() {
initTheme();
    buildKeyboard(); updateDisplay(); sprachDropdownBauen(); crossSellBannerEinfuegen(THIS_APP_ID);
    // Willkommens-Info
    setTimeout(() => {
        showToast('𓋹 Medu Netjer – Gottesworte! Klicke auf Hieroglyphen 𓂋𓂝');
    }, 800);
}
window.addEventListener('DOMContentLoaded', init);
(function(){if(!window.visualViewport)return;window.visualViewport.addEventListener('resize',function(){if((window.innerHeight-window.visualViewport.height)>100){var d=document.getElementById('wordDisplay');if(d)setTimeout(function(){d.scrollIntoView({behavior:'smooth',block:'start'});},150);}});})();
</script>
