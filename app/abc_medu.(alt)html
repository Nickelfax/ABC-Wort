const FREIE_RUNDEN = 10;

function proIstAktiv(appId) {
    const app=APP_REGISTRY.find(a=>a.id===appId);
    if(!app||!app.proCode)return true;
    try{return localStorage.getItem('abc_pro_'+appId)==='true';}catch(e){return false;}
}
function freiRundenCheck() {
    if(proIstAktiv(THIS_APP_ID))return true;
    let r=0;try{r=parseInt(localStorage.getItem('abc_runden_'+THIS_APP_ID)||'0');}catch(e){}
    if(r<FREIE_RUNDEN){try{localStorage.setItem('abc_runden_'+THIS_APP_ID,r+1);}catch(e){}return true;}
    proGateAnzeigen(THIS_APP_ID,'Diktat & Grammatik');return false;
}
function proGateAnzeigen(appId,feature){
    const app=APP_REGISTRY.find(a=>a.id===appId);
    const display=document.getElementById('wordDisplay');if(!display)return;
    display.classList.remove('empty');
    display.innerHTML=`<div style="text-align:center;padding:1rem;width:100%;">
        <div style="font-size:3rem;margin-bottom:8px;">${app.flag}</div>
        <div style="font-size:1rem;font-weight:bold;color:#2c3e50;margin-bottom:6px;">𓋹 Pro-Version</div>
        <div style="font-size:0.85rem;color:var(--stone);margin-bottom:4px;font-style:italic;">${feature} · ohne Ende</div>
        <div style="font-size:1.1rem;font-weight:bold;color:${app.color};margin-bottom:16px;">2,99 € – einmalig</div>
        <button onclick="proKaufen('${appId}')" style="background:${app.color};padding:10px 20px;border-radius:8px;color:white;border:none;cursor:pointer;font-weight:bold;font-size:1rem;margin-bottom:8px;display:block;width:100%;">𓂝 Pro freischalten ☕ – 2,99€</button>
        <button onclick="proCodeEingeben('${appId}')" style="background:#27ae60;padding:8px 20px;border-radius:8px;color:white;border:none;cursor:pointer;font-size:0.85rem;width:100%;">𓌀 Ich habe bereits bezahlt ✓</button>
    </div>`;
}
function proKaufen(appId){window.open('https://ko-fi.com/nickelfax','_blank');showToast('𓇋𓂧𓅱𓏏 Nach der Zahlung erhältst du deinen Code!');}
function proCodeEingeben(appId){
    const code=prompt('𓌀 Pro-Code eingeben:');if(!code)return;
    const app=APP_REGISTRY.find(a=>a.id===appId);if(!app)return;
    if(code.toUpperCase()===app.proCode){
        try{localStorage.setItem('abc_pro_'+appId,'true');localStorage.removeItem('abc_runden_'+appId);}catch(e){}
        showToast('𓋹 Pro aktiviert! Möge Ra dich segnen! 🎉');updateDisplay();
    }else{showToast('𓌀 Falscher Code – nach Zahlung per Ko-fi fragen!');}
}
function crossSellBannerEinfuegen(currentAppId){
    const andere=APP_REGISTRY.filter(a=>a.id!==currentAppId);
    const container=document.createElement('div');container.id='crossSellBanner';
    container.style.cssText='width:100%;max-width:700px;margin-top:24px;background:var(--card-bg);border-radius:8px;border:2px solid var(--sand);box-shadow:4px 4px 0 var(--sand);overflow:hidden;';
    const header=document.createElement('div');header.style.cssText='padding:12px 16px;font-size:0.8rem;font-weight:bold;color:var(--stone);text-transform:uppercase;letter-spacing:2px;border-bottom:1px solid var(--sand);';
    header.textContent='🌍 Auch verfügbar';container.appendChild(header);
    andere.forEach(app=>{
        const aktiv=proIstAktiv(app.id);const item=document.createElement('div');
        item.style.cssText='display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--sand);cursor:pointer;transition:background 0.15s;';
        item.onmouseenter=()=>item.style.background=var_sand_light;item.onmouseleave=()=>item.style.background='';
        item.onclick=()=>window.location.href=app.file;
        item.innerHTML=`<div style="display:flex;align-items:center;gap:12px;"><span style="font-size:1.8rem;">${app.flag}</span>
            <div><div style="font-weight:bold;color:#2c3e50;font-size:0.95rem;">${app.name}</div>
            <div style="font-size:0.8rem;color:var(--stone);">${app.subtitle}</div></div></div>
            <div style="display:flex;align-items:center;gap:8px;">
            ${aktiv?'<span style="background:#eafaf1;color:#27ae60;font-size:0.75rem;font-weight:bold;padding:3px 8px;border-radius:20px;">✓ Aktiviert</span>':'<span style="background:#fff8e1;color:#e67e22;font-size:0.75rem;font-weight:bold;padding:3px 8px;border-radius:20px;">2,99 €</span>'}
            <span style="color:#bdc3c7;font-size:1.2rem;">›</span></div>`;
        container.appendChild(item);
    });
    const aktiviertePros=APP_REGISTRY.filter(a=>a.proCode&&proIstAktiv(a.id));
    if(aktiviertePros.length>=2){const hub=document.createElement('div');hub.style.cssText='padding:12px 16px;background:linear-gradient(135deg,#b8860b22,#7b1fa222);display:flex;align-items:center;justify-content:space-between;';hub.innerHTML='<div><div style="font-weight:bold;color:#2c3e50;font-size:0.9rem;">🏆 Pro Plus Hub</div><div style="font-size:0.75rem;color:var(--stone);font-style:italic;">Omnes linguae – 𓇋𓂧𓅱𓏏 – bald</div></div><span style="background:#fff8e1;color:var(--primary);font-size:0.75rem;font-weight:bold;padding:3px 8px;border-radius:20px;">Bald</span>';container.appendChild(hub);}
    const kb=document.querySelector('.keyboard-container');
    if(kb&&kb.parentNode)kb.parentNode.insertBefore(container,kb.nextSibling);else document.body.appendChild(container);
}
const var_sand_light = '#fdf8ec';
