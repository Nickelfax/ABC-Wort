function uebersetzungsAktuellesWort() {
    if (diktatAktiv && diktatAktuell) {
        const e = diktatWorteN1.concat(diktatWorteN2, diktatWorteN3).find(w => w.wort === diktatAktuell);
        return e ? e.de : diktatAktuell;
    }
    return '';
}
function uebersetzeUndZeige(text) {
    if (!uebersetzungAktiv || !text) return;
    const anzeige = document.getElementById('uebersetzungAnzeige');
    const sprache = sprachen.find(s => s.code === userLang);
    const flag    = sprache ? sprache.flag : '🌍';
    // Lokales Dict für Hieroglyphen
    const eintrag = woerterBuch.find(w => w.de === text || w.en === text || w.hiero === text);
    if (eintrag) {
        anzeige.innerHTML = `${flag} <strong>${eintrag.de}</strong> · <em>${eintrag.laut}</em>`;
        return;
    }
    anzeige.textContent = flag + ' ' + text;
}

// ── TTS: Altägyptisch ist tot – wir sprechen Koptisch/Arabisch als Annäherung ──
function sprichAegy(text) {
    // Versuche Transliteration zu sprechen, nicht die Hieroglyphen selbst
    window.speechSynthesis.cancel();
    const voices = window.speechSynthesis.getVoices();
    // Koptisch existiert in keinem Browser-TTS → Arabisch als Annäherung
    const voice = voices.find(v => v.lang.startsWith('ar')) ||
                  voices.find(v => v.lang.startsWith('he')) ||
                  voices.find(v => v.lang.startsWith('de'));
    if (!voice) { _sprichAegyGoogle(text); return; }
    const u = new SpeechSynthesisUtterance(text);
    u.lang = voice.lang.startsWith('ar') ? 'ar-SA' : 'de-DE';
    u.rate = 0.6; // Langsam und feierlich 🏺
    u.voice = voice;
    window.speechSynthesis.speak(u);
}
function _sprichAegyGoogle(text) {
    try {
        const url = 'https://translate.google.com/translate_tts?ie=UTF-8&tl=ar&q=' +
            encodeURIComponent(text) + '&client=tw-ob';
        new Audio(url).play().catch(() => {});
    } catch(e) {}
}
function sprichWort() {
    // Spreche die Transliteration des aktuellen Wortes
    const s = currentWord.join('');
    if (!s) return;
    // Finde Transliteration
    const uni = uniliterale.find(u => u.zeichen === s);
    if (uni) sprichAegy(uni.laut);
    else showToast('𓌀 Hieroglyphen haben keinen Laut im Browser – Koptisch wäre nötig! 🏺');
}
function sprichZeichenTTS(ch) {
    const uni = uniliterale.find(u => u.zeichen === ch);
    if (uni && uni.laut) sprichAegy(uni.laut);
    // Biliterale/Triliterale/Determinative → kein Einzellaut
}

